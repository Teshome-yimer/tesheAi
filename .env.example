APP_NAME="Course Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tesheai.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=course_platform
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Set to your production domain (or leave empty to default to the app domain)
SESSION_DOMAIN=tesheai.com
# Use secure cookies in production (true when serving over HTTPS)
SESSION_SECURE_COOKIE=true
# SameSite recommendation: 'lax' is a safe default
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@courseplatform.com"
MAIL_FROM_NAME="${APP_NAME}"

# Chapa Payment (Ethiopia)
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook: https://yourdomain.com/payment/chapa/callback

# Stripe Payment (International)
STRIPE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook: https://yourdomain.com/api/webhooks/stripe
